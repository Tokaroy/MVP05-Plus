<?xml version="1.0" encoding="utf-8"?>
<!-- The Xbox (Dev Mode) app's manifest. Build-Xbox.cmd fills in the version and packs it with MVP05.exe and the
     tiles, made from your disc's title image by make_tiles.py. No other game files are in the package: the app runs
     the game from your MVP05-Plus folder on a USB drive, or from its own storage (LocalState). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="spyjam.MVP05Plus" Publisher="CN=MVP05-Plus" Version="@VERSION@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MVP05-Plus</DisplayName>
    <PublisherDisplayName>spy_jam</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
    <!-- the C++ runtime for apps (vcruntime140_app); Build-Xbox.cmd puts its package beside this one -->
    <PackageDependency Name="Microsoft.VCLibs.140.00.UWP" MinVersion="14.0.24217.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="MVP05.exe" EntryPoint="MVP05Plus.App">
      <uap:VisualElements DisplayName="MVP05-Plus" Description="MVP Baseball 2005, from your own game files"
        BackgroundColor="#000000" Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#000000" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- system link and the co-op join: the game's own network play -->
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <!-- your MVP05-Plus folder on a USB drive -->
    <uap:Capability Name="removableStorage" />
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>
</Package>
